post_install() {
    echo "==> nvm-fish has been installed successfully!"
    echo ""
    echo "==> IMPORTANT: Please restart your fish shell to enable nvm-fish:"
    echo "    - Close and reopen your terminal, OR"
    echo "    - Run: exec fish"
    echo ""
    echo "==> After restarting fish, run 'nvm init' to initialize nvm-fish"
    echo ""
    echo "==> The initialization will:"
    echo "    - Detect and install bass (if needed)"
    echo "    - Configure Fish shell integration"
    echo "    - Enable automatic .nvmrc version switching"
    echo ""
    echo "==> Once initialized, all nvm commands work normally:"
    echo "    nvm --version, nvm install node, nvm use 16, etc."
    echo ""
    echo "==> Dependencies:"
    echo "    ✔ nvm (installed as package dependency)"
    echo "    ✔ bass (auto-installed during nvm init)"
    echo ""
    echo "==> Documentation: https://github.com/your-username/nvm-fish"
}

post_upgrade() {
    echo "==> nvm-fish has been upgraded!"
    echo ""
    echo "==> Please restart your fish shell to load the updated functions:"
    echo "    - Close and reopen your terminal, OR"  
    echo "    - Run: exec fish"
}

post_remove() {
    echo "==> nvm-fish has been removed."
    echo ""
    echo "==> Performing automatic cleanup..."

    # 只清理「是符号链接」且「指向 /usr/share/nvm/」的项，
    # 避免误删官方安装或用户自建的真实文件。
    cleanup_user_links() {
        local user_home="$1"
        local nvm_dir=""

        if [[ -z "$user_home" ]]; then
            return
        fi

        # 推断该用户的 NVM_DIR：优先 XDG 路径，回退默认路径
        if [[ -d "$user_home/.config/nvm" ]]; then
            nvm_dir="$user_home/.config/nvm"
        else
            nvm_dir="$user_home/.nvm"
        fi

        local link
        for link in "$nvm_dir/nvm.sh" "$nvm_dir/nvm-exec"; do
            if [[ -L "$link" ]]; then
                local target
                target="$(readlink "$link" 2>/dev/null || true)"
                case "$target" in
                    /usr/share/nvm/*)
                        echo "    Removing symlink: $link -> $target"
                        rm -f "$link" 2>/dev/null || true
                        ;;
                    *)
                        echo "    Leaving symlink (not managed by nvm-fish): $link -> $target"
                        ;;
                esac
            fi
        done
    }

    # 清理 Fish 集成：config.fish 块、函数文件、setup marker、bass 提示
    cleanup_user_config() {
        local user_home="$1"
        local fish_config="$user_home/.config/fish/config.fish"
        local setup_marker="$user_home/.config/nvm-fish-setup-done"
        local bass_uninstaller="$user_home/.local/bin/uninstall-bass-nvm-fish.sh"

        if [[ -f "$fish_config" ]]; then
            # 1) 优先按块标记整块删除（与 __nvm_auto_configure_fish 写入的标记一致）
            if grep -qF "# >>> nvm-fish init >>>" "$fish_config" 2>/dev/null; then
                echo "    Removing nvm-fish block from Fish config: $(basename "$user_home")"
                sed -i '/^# >>> nvm-fish init >>>/,/^# <<< nvm-fish init <<</d' "$fish_config" 2>/dev/null || true
            fi

            # 2) 兼容旧版零散行（旧版写入的是 load_nvm 三行）
            if grep -q "load_nvm\|nvm-fish integration\|You must call it on initialization" "$fish_config" 2>/dev/null; then
                echo "    Removing legacy nvm-fish lines from Fish config: $(basename "$user_home")"
                sed -i \
                    -e '/load_nvm/d' \
                    -e '/nvm-fish integration/d' \
                    -e "/You must call it on initialization/d" \
                    "$fish_config" 2>/dev/null || true
            fi

            # 3) 去掉文件末尾因删除而遗留的空行
            sed -i -e :a -e '/^\s*$/N; s/\n//; ta' "$fish_config" 2>/dev/null || true
        fi

        # 4) 删除可能由 nvm-fish 生成的 Fish 集成文件（仅当内容含特征时才删）
        local f
        for f in \
            "$user_home/.config/fish/functions/nvm.fish" \
            "$user_home/.config/fish/conf.d/nvm.fish" \
            "$user_home/.config/fish/completions/nvm.fish"
        do
            if [[ -f "$f" ]] && grep -q "nvm-fish\|__nvm_run_setup\|load_nvm" "$f" 2>/dev/null; then
                echo "    Removing Fish integration file: $f"
                rm -f "$f" 2>/dev/null || true
            fi
        done

        # 5) 删除 setup marker
        if [[ -f "$setup_marker" ]]; then
            echo "    Removing setup marker for user: $(basename "$user_home")"
            rm -f "$setup_marker" 2>/dev/null || true
        fi

        # 6) bass 提示（保持不自动删除）
        if [[ -f "$bass_uninstaller" ]]; then
            echo ""
            echo "==> Bass was installed by nvm-fish for user: $(basename "$user_home")"
            echo ""
            echo "    To remove bass (if no longer needed):"
            echo "    $bass_uninstaller"
            echo ""
            echo "    Or keep it if you use bass for other purposes."
            echo ""
        elif [[ -f "$user_home/.config/fish/functions/bass.fish" ]]; then
            echo ""
            echo "==> Bass found for user: $(basename "$user_home")"
            echo "    (installed independently, not by nvm-fish - left unchanged)"
            echo ""
        fi
    }

    cleanup_one_user() {
        local user_home="$1"
        cleanup_user_config "$user_home"
        cleanup_user_links "$user_home"
    }

    # 当前用户（非 root 时）
    if [[ -n "$HOME" ]] && [[ "$HOME" != "/root" ]]; then
        cleanup_one_user "$HOME"
    fi

    # 以 root 运行时，尝试清理 /home 下所有用户
    if [[ "$EUID" -eq 0 ]] || [[ "$UID" -eq 0 ]]; then
        for user_home in /home/*; do
            if [[ -d "$user_home" ]]; then
                cleanup_one_user "$user_home"
            fi
        done
    fi

    echo "==> Cleanup completed. The following were preserved:"
    echo "    ✔ Official nvm installation and configuration"
    echo "    ✔ NVM_DIR directory and all Node.js versions installed via nvm"
    echo "    ✔ Bass (see above for removal options if needed)"
    echo ""
    echo "==> IMPORTANT: Please restart your Fish shell to clear function cache:"
    echo "    - Close and reopen your terminal, OR"
    echo "    - Run: exec fish"
    echo ""
    echo "==> If you experience any Fish startup errors, run:"
    echo "    sed -i '/^# >>> nvm-fish init >>>/,/^# <<< nvm-fish init <<</d' ~/.config/fish/config.fish"
    echo ""
    echo "==> Thanks for using nvm-fish!"
}